{
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",

    "target": "ES2023",
    "outDir": "./dist",
    "rootDir": "./src",

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "esModuleInterop": true,
    "skipLibCheck": true,

    "ignoreDeprecations": "5.0"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "test", "**/*.spec.ts"]
}